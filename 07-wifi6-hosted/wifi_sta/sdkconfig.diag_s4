# ESP32-P4X-Function-EV-Board（ESP-IDF v6.0.3）: オンボードの ESP32-C6 を ESP-Hosted（SDIO）で Wi-Fi に使う
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Wi-Fi の相手（コプロセッサ）は ESP32-C6
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y

# --- 接続の調査 s4: 今の設定のまま、esp_wifi_connect() を送信出力の設定の後に（STA_START では呼ばない） ---
CONFIG_WIFI_STA_CONNECT_AFTER_SETUP=y
