# ESP32-P4X-Function-EV-Board（ESP-IDF v6.0.3）: オンボードの ESP32-C6 を ESP-Hosted（SDIO）で Wi-Fi に使う
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Wi-Fi の相手（コプロセッサ）は ESP32-C6
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
# iperf のコンソールは J19（USB Serial/JTAG）に出す
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- 性能の設定 B: lwIP の TCP（ESP-Hosted docs/performance_optimization.md §1.1 の TCP/IP Performance） ---
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SACK_OUT=y
